ARG GO_VERSION
FROM docker.io/library/golang:${GO_VERSION}-bookworm AS go-tools

RUN go install golang.org/x/tools/gopls@latest && \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest && \
    go install golang.org/x/tools/cmd/goimports@latest && \
    go install mvdan.cc/sh/v3/cmd/shfmt@latest && \
    go install github.com/mikefarah/yq/v4@latest

# Build from source because timestamp filenames cannot be packaged in a Go zip.
RUN git clone --depth 1 https://github.com/kubevirt/ci-health.git /tmp/ci-health && \
    cd /tmp/ci-health && \
    go build -o /go/bin/ci-failures ./cmd/ci-failures/

FROM docker.io/library/node:22-bookworm

ARG GO_VERSION
ARG KILO_VERSION
ARG USER_UID=1000
ARG USER_GID=1000
ARG USER_HOME=/home/kilo

RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs openssh-client less procps jq vim ripgrep shellcheck skopeo \
    curl ca-certificates yamllint python3 python3-venv locales && \
    localedef -i en_US -f UTF-8 en_US.UTF-8 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN arch="$(dpkg --print-architecture)" && \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" \
      | tar -C /usr/local -xz
COPY --from=go-tools /go/bin/ /usr/local/bin/

RUN test -n "$KILO_VERSION" && \
    npm install -g "@kilocode/cli@${KILO_VERSION}" kubernetes-mcp-server

RUN userdel -r node && \
    groupadd --gid "${USER_GID}" kilo && \
    useradd --uid "${USER_UID}" --gid "${USER_GID}" -m -d "${USER_HOME}" -s /bin/bash kilo && \
    mkdir -p "${USER_HOME}/go" /tmp/kilo && \
    chown kilo:kilo "${USER_HOME}/go" && \
    chown -R kilo:kilo /tmp/kilo && chmod 700 /tmp/kilo

ENV HOME=${USER_HOME}
ENV GOROOT=/usr/local/go
ENV GOPATH=${USER_HOME}/go
ENV PATH="${GOPATH}/bin:${GOROOT}/bin:${PATH}"
ENV KILO_DISABLE_AUTOUPDATE=true
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# Managed policy and validator remain owned by root, outside host state mounts.
COPY managed-kilo.json /etc/kilo/kilo.json
COPY kilo-security.mjs /usr/local/share/kilo/kilo-security.mjs
RUN chmod 755 /etc/kilo /usr/local/share/kilo && \
    chmod 644 /etc/kilo/kilo.json /usr/local/share/kilo/kilo-security.mjs

USER kilo
WORKDIR ${USER_HOME}
ENTRYPOINT ["kilo"]
