{
  "$schema": "https://app.kilo.ai/config.json",
  "plugin": ["file:///usr/local/share/kilo/kilo-security.mjs"],
  "autoupdate": false,
  "share": "disabled",
  "experimental": { "openTelemetry": false },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "allow",
    "task": "ask",
    "todowrite": "allow",
    "semantic_search": "ask",
    "gopls_go_workspace": "allow",
    "gopls_go_search": "allow",
    "gopls_go_file_context": "allow",
    "gopls_go_package_api": "allow",
    "gopls_go_diagnostics": "allow",
    "gopls_go_symbol_references": "allow",
    "kubernetes_pods_list": "allow",
    "kubernetes_pods_list_in_namespace": "allow",
    "kubernetes_pods_get": "allow",
    "kubernetes_pods_log": "allow",
    "kubernetes_pods_top": "allow",
    "kubernetes_resources_list": "allow",
    "kubernetes_resources_get": "allow",
    "kubernetes_namespaces_list": "allow",
    "kubernetes_events_list": "allow",
    "kubernetes_configuration_contexts_list": "allow",
    "kubernetes_configuration_view": "allow",
    "kubernetes_nodes_top": "allow",
    "kubernetes_nodes_log": "allow",
    "kubernetes_nodes_stats_summary": "allow"
  },
  "agent": {
    "code": { "permission": { "semantic_search": "ask" } }
  }
}
